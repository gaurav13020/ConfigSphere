POSTGRES_DB=configsphere_v2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DYNAMODB_ENDPOINT=http://dynamodb-local:8000
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE=config_payloads

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=configsphere
KEYCLOAK_AUDIENCE=configsphere-v2
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/configsphere/protocol/openid-connect/certs
AUTH_DEV_MODE=true
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

CONTROL_PLANE_PORT=8100
DELIVERY_PORT=8101

REDIS_URL=redis://redis:6379/0
KAFKA_INVALIDATION_TOPIC=config.invalidated
CACHE_L1_TTL_SECONDS=600
CACHE_L2_TTL_SECONDS=1800

# Jira integration
JIRA_ENABLED=false
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=CS
JIRA_ISSUE_TYPE=Task
# Transition IDs – run GET /rest/api/3/issue/{key}/transitions to find yours
JIRA_TRANSITION_SUBMITTED=
JIRA_TRANSITION_APPROVED=
JIRA_TRANSITION_IMPLEMENTING=
JIRA_TRANSITION_IMPLEMENTED=
JIRA_TRANSITION_REJECTED=
