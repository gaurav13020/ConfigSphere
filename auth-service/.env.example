# Django
DJANGO_SECRET_KEY=replace-with-a-strong-secret
DJANGO_SETTINGS_MODULE=auth_service.settings.local

# Database (dedicated authsphere DB)
DB_NAME=authsphere
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Jira OAuth 2.0 App (register at https://developer.atlassian.com/console/)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:8001/api/v1/oauth/jira/callback/
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_PROJECT_KEY=CONFIGSPHERE

# JWT — MUST match the value set in the config server
JWT_SECRET_KEY=replace-with-a-strong-shared-secret
JWT_ACCESS_TOKEN_EXPIRY_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRY_SECONDS=86400

# Frontend redirect after OAuth
FRONTEND_URL=http://localhost:3000
