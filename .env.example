# ConfigSphere Environment Variables

# ============================================
# Database Configuration
# ============================================
DB_NAME=configsphere
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ============================================
# Django Configuration
# ============================================
DJANGO_SETTINGS_MODULE=config_sphere.settings.local
DJANGO_SECRET_KEY=dev-insecure-key-replace-in-production-with-50-chars-min-key
DEBUG=True

# ============================================
# Frontend Configuration  
# ============================================
VITE_API_URL=http://localhost:8000/api/v1

# ============================================
# Production Settings (update these for production)
# ============================================
# DJANGO_SETTINGS_MODULE=config_sphere.settings.production
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# VITE_API_URL=https://api.yourdomain.com/api/v1
